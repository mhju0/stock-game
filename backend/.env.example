# REQUIRED — app will refuse to start without this.
# Generate a strong random secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Required in production: the sole allowed CORS origin. Leave unset locally to
# allow the documented localhost dev servers.
# FRONTEND_URL=https://your-production-frontend.com

# Required in production: Supabase Postgres connection string. Leave unset only
# for local development, where the app falls back to SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local-only developer controls: the /admin fund routes and the /docs, /redoc
# and /openapi.json pages. Keep false/unset in production.
ENABLE_DEV_TOOLS=false
